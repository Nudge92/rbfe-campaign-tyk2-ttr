integrator              = md
dt                      = 0.002
nsteps                  = 4000000
nstlog                  = 50
nstenergy               = 50
nstxout                 = 0
nstvout                 = 0
nstxout-compressed      = 200
compressed-x-grps       = SEL
continuation            = yes
constraint_algorithm    = lincs
constraints             = h-bonds
lincs_order             = 12
lincs_iter              = 1
cutoff-scheme           = Verlet
nstlist                 = 20
coulombtype             = PME
pme_order               = 4
fourierspacing          = 0.12
rcoulomb                = 1.0
rvdw                    = 1.0
DispCorr                = EnerPres
pbc                     = xyz
tcoupl                  = V-rescale
tc-grps                 = System
tau_t                   = 0.1
ref_t                   = 310
pcoupl                  = C-rescale
pcoupltype              = isotropic
tau_p                   = 1.0
ref_p                   = 1.0
compressibility         = 4.5e-5
gen_vel                 = no
ld_seed                 = 20260912
; ===== 3블록 레그1: 소멸 원자 방전 · 8창 · 사다리 v12e · Δλ [0.1428, 0.1429] =====
free-energy              = yes
init-lambda-state        = 0
fep-lambdas              = 0 0 0 0 0 0 0 0
coul-lambdas             = 0 0.1429 0.2857 0.4286 0.5714 0.7143 0.8571 1
vdw-lambdas              = 0 0 0 0 0 0 0 0
bonded-lambdas           = 0 0 0 0 0 0 0 0
sc-alpha                 = 0.5
sc-power                 = 1
sc-sigma                 = 0.3
sc-coul                  = no
nstdhdl                  = 100
calc-lambda-neighbors    = -1
dhdl-derivatives         = yes
separate-dhdl-file       = yes
